APP_NAME=split-bill-go
APP_PORT=8080
APP_ENV=local
JWT_SECRET=change-me

# Origin frontend yang dipisah dari backend (dipisah koma).
# Kosongkan kalau frontend dan backend satu origin / pakai reverse proxy.
# Contoh: CORS_ALLOWED_ORIGINS=https://splitkita.id,https://www.splitkita.id
CORS_ALLOWED_ORIGINS=

# Google OAuth Web Client ID (audience token Google).
GOOGLE_CLIENT_ID=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
